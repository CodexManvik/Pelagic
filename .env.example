DATABASE_URL=postgresql://user:password@host/database?sslmode=require
APP_NAME=FloatChat AI Backend
ENVIRONMENT=local
LOG_LEVEL=INFO
AUTO_CREATE_SCHEMA=true

GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192
GROQ_TEMPERATURE=0.2
GROQ_MAX_RETRIES=2
GROQ_TIMEOUT_SECONDS=30

SQL_ALLOWLIST_TABLES=floats,profiles,measurements,active_floats_summary
SQL_MAX_ROWS=500
SQL_MAX_RETRIES=1
SQL_MAX_COST=1000
MEASUREMENT_TTL_DAYS=7

QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_TARGET_URL=http://localhost:8000/api/webhooks/argo-ingest

ARGO_INDEX_URL=
ARGO_INDEX_MAX_LINES=500
ARGO_MAX_PROFILES=50
ARGO_EVENTS_PER_PROFILE=3
ARGO_BATCH_SIZE=100
ARGO_PROFILE_CACHE_PREFIX=argo:profile
ARGO_PROFILE_CACHE_TTL_DAYS=7

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
