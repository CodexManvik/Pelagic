DATABASE_URL=postgresql://user:password@host/database?sslmode=require
APP_NAME=FloatChat AI Backend
ENVIRONMENT=local
LOG_LEVEL=INFO
AUTO_CREATE_SCHEMA=true

GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192
GROQ_TEMPERATURE=0.2
GROQ_MAX_RETRIES=2
GROQ_TIMEOUT_SECONDS=30

SQL_ALLOWLIST_TABLES=floats,profiles,measurements
SQL_MAX_ROWS=500
SQL_MAX_RETRIES=1
MEASUREMENT_TTL_DAYS=7

QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_TARGET_URL=http://localhost:8000/api/webhooks/argo-ingest

KAFKA_BROKERS=
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_TOPIC=argo-events
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-256

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
